# BUGX Environment Variables

# Backend API Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# LLM Provider Configuration
# Supported providers: "openai", "anthropic", "gemini", "mock"
LLM_PROVIDER=mock

# Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Default LLM Models
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-1.5-pro

# Temporary Directory for Git Clones
WORKSPACE_TEMP_DIR=
